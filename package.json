{
  "name": "saps-case-docket-system",
  "version": "0.1.0",
  "description": "SAPS Case Docket Accountability and Registration Integrity System",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testPathPattern=integration",
    "test:e2e": "jest --testPathPattern=e2e",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "migrate": "node src/database/migrate.js",
    "build": "webpack --mode production",
    "docker:build": "docker build -t saps-docket-system .",
    "docker:run": "docker run -p 3000:3000 saps-docket-system"
  },
  "keywords": [
    "SAPS",
    "police",
    "accountability",
    "docket",
    "case-management"
  ],
  "author": "Durban University of Technology",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.8.0",
    "jsonwebtoken": "^9.0.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.0.3",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "morgan": "^1.10.0",
    "joi": "^17.9.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.20",
    "jest": "^29.5.0",
    "supertest": "^6.3.3",
    "eslint": "^8.35.0",
    "prettier": "^2.8.4"
  }
}
