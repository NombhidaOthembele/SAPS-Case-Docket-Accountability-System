# Environment variables
NODE_ENV=development
PORT=3000

# Twilio SMS provider (set locally before testing real OTP delivery)
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+12025550123

# Demo values for local development
# If Twilio is not configured, the app will still generate a demo OTP in the server terminal.

# Application defaults
APP_NAME=SAPS Docket System
