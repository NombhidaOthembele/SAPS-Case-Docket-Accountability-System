# Application
NODE_ENV=development
PORT=3000
APP_NAME=SAPS Docket System

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=saps_docket_db
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRY=24h

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info
LOG_FORMAT=combined

# Security
BCRYPT_ROUNDS=10
ENCRYPTION_KEY=your_encryption_key_here

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_password

# Audit
AUDIT_LOG_RETENTION_DAYS=2555
